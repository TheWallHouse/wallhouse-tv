<resources>
    <!-- Window theme only; everything inside is Compose (see ui/theme/Theme.kt). -->
    <style name="Theme.Tellyscope" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Launch splash: plain black, so the opening scene (ui/IntroScreen.kt) follows without a jump.
         installSplashScreen() swaps in Theme.Tellyscope. -->
    <style name="Theme.Tellyscope.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_icon_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Tellyscope</item>
    </style>
</resources>
